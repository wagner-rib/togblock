---
import '@fontsource/baloo-2/500.css';
import '@fontsource/baloo-2/600.css';
import '@fontsource/baloo-2/700.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/400-italic.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '../styles/tokens.css';
import '../styles/vibes.css';
import '../styles/global.css';
import '../styles/builder.css';
import '../styles/pages.css';
import '../styles/product.css';
import '../styles/home.css';
import { getTokenFromRequest, getSession } from '../lib/auth';

interface Props {
  title: string;
  description: string;
  currentPage?: string;
  ogImage?: string;
}

const { title, description, currentPage = '/', ogImage = '/og.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// FIX-05: tracking IDs come from the runtime env (.env → container). Unset = no tracking, no banner.
const rawPixel = process.env.META_PIXEL_ID ?? '';
const rawGa4   = process.env.GA4_MEASUREMENT_ID ?? '';
const META_PIXEL_ID = /^\d{5,20}$/.test(rawPixel) ? rawPixel : '';
const GA4_ID        = /^G-[A-Z0-9]{4,15}$/.test(rawGa4) ? rawGa4 : '';
const trackingEnabled = Boolean(META_PIXEL_ID || GA4_ID);

const token = getTokenFromRequest(Astro.request);
const user  = token ? await getSession(token) : null;

const navItems = [
  { label: 'Products',     href: '/products' },
  { label: 'Build now',     href: '/builder' },
  { label: 'About',        href: '/about' },
  { label: 'FAQ',          href: '/faq' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:image"       content={new URL(ogImage, Astro.site)} />
  <meta property="og:locale"      content="en_IE" />
  <meta property="og:site_name"   content="TógBlocks" />

  <!-- Twitter card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(ogImage, Astro.site)} />

  <!-- SEO signals -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="geo.region" content="IE" />
  <meta name="geo.placename" content="Ireland" />
  <meta name="rating" content="General" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Theme colour -->
  <meta name="theme-color" content="#1D4ED8" />

  <!-- JSON-LD: Organisation + WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://togblocks.com/#organization",
        "name": "TógBlocks",
        "url": "https://togblocks.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://togblocks.com/logo.svg"
        },
        "description": "Personalised 3D brick name letters and door signs, 3D printed in Ireland. Compatible with LEGO®.",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "IE"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "togblocks@outlook.com",
          "availableLanguage": ["en", "ga"]
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://togblocks.com/#website",
        "url": "https://togblocks.com",
        "name": "TógBlocks",
        "publisher": { "@id": "https://togblocks.com/#organization" }
      }
    ]
  })} />

  <!-- Page-specific head content (JSON-LD, etc.) -->
  <slot name="head" />

  <!-- Analytics + consent (FIX-05). Nothing loads until the visitor accepts. -->
  <script is:inline define:vars={{ META_PIXEL_ID, GA4_ID }}>
    (function () {
      var KEY = 'tb_consent', queue = [], loaded = false;
      var enabled = !!(META_PIXEL_ID || GA4_ID);
      var GA_NAMES = { ViewContent: 'view_item', AddToCart: 'add_to_cart', InitiateCheckout: 'begin_checkout', Purchase: 'purchase' };

      function getConsent() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
      function setConsent(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

      function load() {
        if (loaded) return; loaded = true;
        if (META_PIXEL_ID) {
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', META_PIXEL_ID);
          fbq('track', 'PageView');
        }
        if (GA4_ID) {
          var g = document.createElement('script');
          g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
          document.head.appendChild(g);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', GA4_ID);
        }
        queue.splice(0).forEach(function (e) { send(e[0], e[1]); });
      }

      function send(name, d) {
        var currency = d.currency || 'EUR';
        var items = d.items || (d.id ? [{ id: d.id, name: d.name, price: d.value, quantity: 1 }] : []);
        if (window.fbq) {
          var fb = {
            value: d.value, currency: currency, content_type: 'product',
            content_ids: items.map(function (i) { return i.id; }),
            contents: items.map(function (i) { return { id: i.id, quantity: i.quantity }; }),
            num_items: items.reduce(function (n, i) { return n + i.quantity; }, 0)
          };
          if (d.name) fb.content_name = d.name;
          fbq('track', name, fb, d.transactionId ? { eventID: 'order-' + d.transactionId } : undefined);
        }
        if (window.gtag) {
          var ga = {
            currency: currency, value: d.value,
            items: items.map(function (i) { return { item_id: i.id, item_name: i.name, price: i.price, quantity: i.quantity }; })
          };
          if (d.transactionId) ga.transaction_id = String(d.transactionId);
          gtag('event', GA_NAMES[name], ga);
        }
      }

      window.tbTrack = function (name, data) {
        if (!enabled) return;
        var c = getConsent();
        if (c === 'granted') { loaded ? send(name, data) : queue.push([name, data]); }
        else if (c !== 'denied') queue.push([name, data]);
      };

      window.tbConsent = function (choice) {
        setConsent(choice);
        var b = document.getElementById('tb-consent');
        if (b) b.hidden = true;
        if (choice === 'granted') load(); else queue.length = 0;
      };

      window.tbShowConsent = function () {
        var b = document.getElementById('tb-consent');
        if (b) b.hidden = false;
      };

      if (!enabled) return;
      if (getConsent() === 'granted') load();
      else if (!getConsent()) document.addEventListener('DOMContentLoaded', window.tbShowConsent);
    })();
  </script>

  <!-- Stripe.js — loaded globally so Payment Element mounts fast -->
  <script src="https://js.stripe.com/v3/" is:inline></script>

  <!-- Vibe init: apply saved theme before first paint to avoid flash -->
  <script is:inline>
    (function(){
      var v = localStorage.getItem('togblocks_vibe') || 'cobalt';
      if (v !== 'cobalt') document.documentElement.setAttribute('data-vibe', v);
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="/" aria-label="TógBlocks home">
        <!-- Stud mark — uses CSS vars so it recolours with every vibe -->
        <svg class="brand-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="3" y="3" width="42" height="42" rx="13" fill="var(--green)"/>
          <rect x="3" y="3" width="42" height="20" rx="13" fill="white" opacity=".14"/>
          <rect x="3" y="32" width="42" height="13" rx="13" fill="var(--green-deep)" opacity=".5"/>
          <g fill="var(--green-deep)" opacity=".22">
            <circle cx="17" cy="18.4" r="5.4"/>
            <circle cx="31" cy="18.4" r="5.4"/>
            <circle cx="17" cy="32.4" r="5.4"/>
            <circle cx="31" cy="32.4" r="5.4"/>
          </g>
          <g fill="white">
            <circle cx="17" cy="17" r="5.4"/>
            <circle cx="31" cy="17" r="5.4"/>
            <circle cx="17" cy="31" r="5.4"/>
            <circle cx="31" cy="31" r="5.4"/>
          </g>
        </svg>
        <span class="brand-word">Tóg<em>Blocks</em></span>
      </a>

      <nav aria-label="Primary">
        <ul class="nav-links desktop">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPage === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav-actions">
        {user
          ? (
            <a class="nav-account-btn" href="/account" aria-label="My account">
              {user.pictureUrl
                ? <img src={user.pictureUrl} alt="" class="nav-avatar" />
                : <span class="nav-avatar-initial">{user.name[0]}</span>
              }
            </a>
          )
          : (
            <a class="nav-signin-btn" href="/login" aria-label="Sign in">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span>Sign in</span>
            </a>
          )
        }
        <a class="cart-btn" href="/cart" aria-label="Basket">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="cart-count" data-cart-count>0</span>
        </a>
        <button
          class="menu-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mmenu"
          aria-label="Open menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <div class="mobile-menu" id="mmenu" data-mobile-menu>
    <ul>
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={currentPage === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li><a href="/cart" aria-current={currentPage === '/cart' ? 'page' : undefined}>Basket</a></li>
    </ul>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a class="brand brand--footer" href="/" aria-label="TógBlocks home" style="margin-bottom:14px">
            <svg class="brand-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="3" y="3" width="42" height="42" rx="13" fill="rgba(255,255,255,.18)"/>
              <rect x="3" y="3" width="42" height="20" rx="13" fill="white" opacity=".10"/>
              <g fill="white" opacity=".25">
                <circle cx="17" cy="18.4" r="5.4"/>
                <circle cx="31" cy="18.4" r="5.4"/>
                <circle cx="17" cy="32.4" r="5.4"/>
                <circle cx="31" cy="32.4" r="5.4"/>
              </g>
              <g fill="white" opacity=".85">
                <circle cx="17" cy="17" r="5.4"/>
                <circle cx="31" cy="17" r="5.4"/>
                <circle cx="17" cy="31" r="5.4"/>
                <circle cx="31" cy="31" r="5.4"/>
              </g>
            </svg>
            <span class="brand-word" style="color:#fff">Tóg<em style="color:var(--orange)">Blocks</em></span>
          </a>
          <p style="color:rgba(255,255,255,.75);max-width:30ch">
            Custom names in bricks, 3D printed in Ireland. <em>Tóg</em> is Irish for "build".
          </p>
        </div>
        <div>
          <h4>Shop</h4>
          <ul>
            <li><a href="/products">All products</a></li>
            <li><a href="/products/brick-letters">Brick Name Letters</a></li>
            <li><a href="/products/door-sign">Door / Room Sign</a></li>
            <li><a href="/cart">Basket</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="/about">Our story</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/faq#shipping">Shipping</a></li>
            {trackingEnabled && <li><button type="button" class="footer-link-btn" onclick="tbShowConsent()">Cookie settings</button></li>}
          </ul>
        </div>
        <div>
          <h4>Stay in touch</h4>
          <p style="color:rgba(255,255,255,.75);margin-bottom:12px">The odd email, the odd discount.</p>
          <form class="newsletter-form" data-newsletter>
            <label class="sr-only" for="nlf">Email</label>
            <input class="input" id="nlf" type="email" required placeholder="you@example.ie" />
            <button class="btn btn--cta btn--sm" type="submit">Join</button>
          </form>
          <p data-newsletter-msg hidden></p>
        </div>
      </div>
      <div class="footer-disclaimer">
        <span>
          Compatible with LEGO®. TógBlocks is independent and not affiliated with, endorsed by,
          or sponsored by the LEGO Group. LEGO® is a trademark of the LEGO Group.
        </span>
        <span>© <span data-year></span> TógBlocks · Made in Ireland 🇮🇪</span>
      </div>
    </div>
  </footer>

  {trackingEnabled && (
    <div class="consent" id="tb-consent" role="dialog" aria-live="polite" aria-label="Cookie preferences" hidden>
      <p>
        We'd like to use analytics and advertising cookies (Google Analytics, Meta) to see which ads
        bring people here and improve the shop. Nothing is set unless you say yes.
      </p>
      <div class="consent__actions">
        <button type="button" class="btn btn--ghost btn--sm" onclick="tbConsent('denied')">Reject</button>
        <button type="button" class="btn btn--primary btn--sm" onclick="tbConsent('granted')">Accept</button>
      </div>
    </div>
  )}

  <script>
    import '../scripts/site.ts';
  </script>
  <script>
    import '../scripts/vibes.ts';
  </script>
  <script>
    import '../scripts/slider.ts';
  </script>
</body>

<style>
/* ── NAV ACCOUNT / SIGN-IN ────────────────────────────────── */
.nav-account-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  text-decoration: none;
  transition: box-shadow .15s;
}
.nav-account-btn:hover { box-shadow: 0 0 0 3px var(--green); }

.nav-avatar {
  width: 32px; height: 32px;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}
.nav-avatar-initial {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: var(--green-deep);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 14px;
}

.nav-signin-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-60);
  text-decoration: none;
  padding: 5px 10px;
  border-radius: 999px;
  border: 1.5px solid var(--line);
  white-space: nowrap;
  transition: border-color .15s, color .15s;
}
.nav-signin-btn:hover { border-color: var(--green); color: var(--green-deep); }

@media (max-width: 600px) {
  .nav-signin-btn span:last-child { display: none; }
}

/* ── COOKIE CONSENT (FIX-05) ──────────────────────────────── */
.consent {
  position: fixed;
  left: 16px; right: 16px; bottom: 16px;
  z-index: 1000;
  max-width: 560px;
  margin-inline: auto;
  background: var(--white);
  color: var(--ink);
  border: 1.5px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-size: var(--fs-sm);
}
.consent[hidden] { display: none; }
.consent__actions { display: flex; gap: 10px; justify-content: flex-end; }
.consent__actions .btn { flex: 1; justify-content: center; }

.footer-link-btn {
  background: none; border: 0; padding: 0;
  font: inherit; color: var(--offwhite); opacity: .82; cursor: pointer; text-align: left;
}
.footer-link-btn:hover { opacity: 1; text-decoration: underline; }
</style>
</html>
