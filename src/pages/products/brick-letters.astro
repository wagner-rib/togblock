---
import Base from '../../layouts/Base.astro';

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Personalised Brick Name Letters",
  "description": "Chunky personalised 3D brick name letters, compatible with standard building brick systems including LEGO®. 3D printed in Ireland, ships in 3 days.",
  "image": "https://togblocks.ie/products/luca-letters.jpg",
  "brand": { "@type": "Brand", "name": "TógBlocks" },
  "sku": "BRICK-LETTERS",
  "offers": {
    "@type": "Offer",
    "url": "https://togblocks.ie/products/brick-letters",
    "priceCurrency": "EUR",
    "price": "5.99",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Organization", "name": "TógBlocks" }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "600"
  }
};
---

<Base
  title="Brick Name Letters — TógBlocks"
  description="Personalised 3D brick name letters, compatible with LEGO® and standard building bricks. Each letter a chunky solid block in your chosen colour. 3D printed in Ireland, ships in 3 days."
  currentPage="/products/brick-letters"
  ogImage="/products/luca-letters.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>

  <article>
    <!-- ============ BREADCRUMB + HERO ============ -->
    <section class="section-tight">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/products">Products</a></li>
            <li aria-current="page">Brick Name Letters</li>
          </ol>
        </nav>

        <div class="pdp-hero">
          <!-- Gallery -->
          <div class="pdp-gallery">
            <div class="pdp-main-photo">
              <img
                src="/products/luca-letters.jpg"
                alt="Rainbow 3D brick letters L U C A on wooden surface with LEGO minifigures"
                loading="eager" decoding="async"
                id="main-photo"
              />
            </div>
            <div class="pdp-thumbs">
              <button class="pdp-thumb is-active" data-photo="/products/luca-letters.jpg" aria-label="Main product photo">
                <img src="/products/luca-letters.jpg" alt="" aria-hidden="true" />
              </button>
              <button class="pdp-thumb" data-photo="/products/robert-letters.jpg" aria-label="ROBERT letters photo">
                <img src="/products/robert-letters.jpg" alt="" aria-hidden="true" />
              </button>
              <button class="pdp-thumb" data-photo="/products/finn-letters.jpg" aria-label="FINN letters in blue tones">
                <img src="/products/finn-letters.jpg" alt="" aria-hidden="true" />
              </button>
            </div>
          </div>

          <!-- Info panel -->
          <div class="pdp-info">
            <span class="eyebrow"><span class="stud-dot" style="color:var(--orange)" aria-hidden="true"></span> 3D Printed in Ireland</span>
            <h1 class="pdp-title">Brick Name Letters</h1>
            <div class="pdp-price">
              <span class="price-tag" style="font-size:var(--fs-2xl)">from €5.99</span>
              <span class="muted" style="font-size:var(--fs-sm)">3 sizes (12cm · 15cm · 18cm) · up to 20% off</span>
            </div>

            <!-- Size pricing chips -->
            <div class="size-price-row" aria-label="Size options">
              <div class="sp-chip">
                <span class="sp-name">Small</span>
                <span class="sp-mm">12cm</span>
                <span class="sp-val">€5.99<span class="sp-unit">/letter</span></span>
              </div>
              <div class="sp-chip sp-chip--mid">
                <span class="sp-badge">Popular</span>
                <span class="sp-name">Medium</span>
                <span class="sp-mm">15cm</span>
                <span class="sp-val">€7.99<span class="sp-unit">/letter</span></span>
              </div>
              <div class="sp-chip">
                <span class="sp-name">Premium</span>
                <span class="sp-mm">18cm</span>
                <span class="sp-val">€9.99<span class="sp-unit">/letter</span></span>
              </div>
            </div>

            <p class="pdp-desc">
              Chunky 3D letters built with standard stud spacing — nursery shelf, bedroom desk, cake topper.
              Pick any size, any colour per letter. Order 3 or more and save up to 20%.
            </p>
            <ul class="spec-list">
              <li>
                <span class="si-ico" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                </span>
                Up to 12 letters per name (A–Z and 0–9)
              </li>
              <li>
                <span class="si-ico" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                </span>
                3 sizes: Small (12cm) · Medium (15cm) · Premium (18cm)
              </li>
              <li>
                <span class="si-ico" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                </span>
                13 colours — pick a theme or recolour each letter
              </li>
              <li>
                <span class="si-ico" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                </span>
                Clicks onto any standard LEGO® baseplate
              </li>
              <li>
                <span class="si-ico" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                </span>
                Ships within 3 working days · free over €60
              </li>
            </ul>
            <a class="btn btn--cta btn--lg btn--block" href="/builder?product=letters" style="margin-top:8px">
              Personalise It
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <p class="muted" style="font-size:var(--fs-xs);margin-top:10px;text-align:center">
              Compatible with LEGO®. TógBlocks is independent and not affiliated with the LEGO Group.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FEATURES ============ -->
    <section class="section" style="background:var(--offwhite)" aria-labelledby="features-heading">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="features-heading">Why families love them</h2>
        </div>
        <div class="grid grid-3">
          <div class="card" style="text-align:center">
            <div class="feat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>Premium feel</h3>
            <p class="muted">Solid, satisfying weight. These are not toys — they're display pieces that happen to be bricks.</p>
          </div>
          <div class="card" style="text-align:center">
            <div class="feat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>What you see is what you get</h3>
            <p class="muted">The live preview matches the final product. No surprises when the box arrives.</p>
          </div>
          <div class="card" style="text-align:center">
            <div class="feat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" stroke="currentColor" stroke-width="2"/>
                <path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>Ready in 3 days</h3>
            <p class="muted">3D printed and posted in Ireland. Most orders arrive within 4–5 days total.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PHOTO GALLERY ============ -->
    <section class="section" aria-labelledby="gallery-heading">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="gallery-heading">See them in the wild</h2>
          <p>Real builds from real customers, photographed in their homes.</p>
        </div>
        <div class="pdp-gallery-grid">
          <div class="pdp-gal-item pdp-gal-item--wide">
            <img src="/products/robert-letters.jpg" alt="Rainbow brick letters ROBERT on a dark shelf with Emmet and Sonic minifigures" loading="lazy" decoding="async" />
          </div>
          <div class="pdp-gal-item">
            <img src="/products/finn-letters.jpg" alt="Blue toned brick letters FINN on a white kids room shelf with minifigures" loading="lazy" decoding="async" />
          </div>
          <div class="pdp-gal-item">
            <img src="/products/luca-letters.jpg" alt="Rainbow brick letters LUCA on wooden surface" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PRICING TABLE ============ -->
    <section class="section" style="background:var(--offwhite)" aria-labelledby="pricing-heading">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="pricing-heading">Simple, honest pricing</h2>
          <p>One price per letter — and the more you order, the more you save.</p>
        </div>
        <div class="pricing-table">
          <div class="pt-head">
            <div></div>
            <div>Small<br><small style="font-weight:400;opacity:.75">12cm</small></div>
            <div>Medium<br><small style="font-weight:400;opacity:.75">15cm</small></div>
            <div>Premium<br><small style="font-weight:400;opacity:.75">18cm</small></div>
          </div>
          <div class="pt-row">
            <div>1 letter</div>
            <div>€5.99</div>
            <div>€7.99</div>
            <div>€9.99</div>
          </div>
          <div class="pt-row pt-row--disc">
            <div>2 letters <span class="disc-tag">5% off</span></div>
            <div>€11.38</div>
            <div>€15.18</div>
            <div>€18.98</div>
          </div>
          <div class="pt-row pt-row--disc">
            <div>3 letters <span class="disc-tag">10% off</span></div>
            <div>€16.17</div>
            <div>€21.57</div>
            <div>€26.97</div>
          </div>
          <div class="pt-row pt-row--disc">
            <div>4–6 letters <span class="disc-tag">15% off</span></div>
            <div>from €20.37</div>
            <div>from €27.17</div>
            <div>from €33.97</div>
          </div>
          <div class="pt-row pt-row--disc pt-row--best">
            <div>7+ letters <span class="disc-tag disc-tag--best">20% off</span></div>
            <div>from €33.54</div>
            <div>from €44.74</div>
            <div>from €55.94</div>
          </div>
        </div>
        <p class="muted center" style="margin-top:16px;font-size:var(--fs-sm)">Discount applied automatically at checkout. No codes needed.</p>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="section" aria-labelledby="faq-heading">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="faq-heading">Questions answered</h2>
        </div>
        <div class="faq-list" style="max-width:680px;margin-inline:auto">
          {[
            {
              q: "What sizes are available?",
              a: "Three sizes: Small (12cm — perfect for cake toppers and small shelves), Medium (15cm — our most popular, great for nurseries and desks), and Premium (18cm — makes a real statement on a mantelpiece or bedroom wall)."
            },
            {
              q: "What colours can I choose?",
              a: "13 filament colours: Blue, Red, Yellow, Green, Black, White, Pink, Sage, Sky Blue, Dusty Pink, Terracotta, Silk Gold, and Silk Silver. You can pick a ready-made theme or tap any individual letter to recolour it in the builder."
            },
            {
              q: "Do the letters stay together?",
              a: "Each letter is an individual brick that stands on its own. They don't connect to each other, but they sit neatly side-by-side on a shelf or any flat surface. They also click onto any standard LEGO® baseplate."
            },
            {
              q: "How long does production take?",
              a: "We 3D print and quality-check your order within 2–3 working days, then post it. Most customers in Ireland receive their order within 4–5 days of ordering."
            },
            {
              q: "How much is shipping?",
              a: "Ireland: €4.95. UK: €7.95. EU: €8.95. Rest of world: €14.95. Orders over €60 ship free anywhere."
            },
          ].map(({ q: question, a: answer }) => (
            <div class="faq-item">
              <button class="acc-trigger" aria-expanded="false" aria-controls={`faq-${question.slice(0,10).replace(/\W/g,'')}`}>
                {question}
                <svg class="acc-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="acc-panel" id={`faq-${question.slice(0,10).replace(/\W/g,'')}`} style="max-height:0;overflow:hidden;transition:max-height .3s ease">
                <p class="muted" style="padding:12px 0 4px">{answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section-tight">
      <div class="wrap center">
        <div class="cta-band">
          <div class="studs-deco" aria-hidden="true"></div>
          <h2 style="margin-bottom:12px">Ready to build?</h2>
          <p style="color:rgba(255,255,255,.85);margin-bottom:24px">Takes less than 2 minutes. We do the rest.</p>
          <a class="btn btn--cta btn--lg" href="/builder?product=letters">Personalise It now <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </article>

</Base>

<style>
.pdp-hero {
  display: grid; grid-template-columns: 1.1fr 1fr;
  gap: clamp(24px, 4vw, 60px); align-items: start;
  padding-top: clamp(16px, 2vw, 24px);
}
.pdp-gallery { display: flex; flex-direction: column; gap: 10px; }
.pdp-main-photo {
  border-radius: var(--radius-lg); overflow: hidden;
  aspect-ratio: 4/3; background: var(--offwhite);
}
.pdp-main-photo img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.pdp-thumbs { display: flex; gap: 10px; }
.pdp-thumb {
  width: 80px; height: 60px; border-radius: var(--radius-sm);
  overflow: hidden; border: 2.5px solid transparent; cursor: pointer;
  background: none; padding: 0; flex: none;
  transition: border-color .15s, transform .15s var(--ease-pop);
}
.pdp-thumb:hover { border-color: var(--sage); transform: scale(1.04); }
.pdp-thumb.is-active { border-color: var(--green-deep); }
.pdp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pdp-info { display: flex; flex-direction: column; gap: 16px; padding-top: 4px; }
.pdp-title { font-size: var(--fs-3xl); color: var(--ink); margin-top: 6px; }
.pdp-price { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.pdp-desc { color: #555; line-height: 1.65; font-size: var(--fs-base); }

.feat-icon {
  width: 60px; height: 60px; margin: 0 auto 14px;
  background: var(--green-soft); color: var(--green-deep);
  border-radius: var(--radius-md); display: grid; place-items: center;
}

.pdp-gallery-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: clamp(8px, 1.5vw, 16px);
}
.pdp-gal-item {
  border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 4/3;
}
.pdp-gal-item--wide { aspect-ratio: 16/9; }
.pdp-gal-item img { width: 100%; height: 100%; object-fit: cover; display: block; }

@media (max-width: 820px) {
  .pdp-hero { grid-template-columns: 1fr; }
  .pdp-thumbs { flex-wrap: wrap; }
  .pdp-gallery-grid { grid-template-columns: 1fr 1fr; }
  .pdp-gal-item--wide { grid-column: span 2; }
}
@media (max-width: 500px) {
  .pdp-gallery-grid { grid-template-columns: 1fr; }
  .pdp-gal-item--wide { grid-column: span 1; }
}

/* ── Size pricing chips in hero ── */
.size-price-row {
  display: flex; gap: 8px;
}
.sp-chip {
  flex: 1; position: relative;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 10px 8px; border-radius: var(--radius-md);
  border: 1.5px solid var(--line); background: var(--offwhite);
  text-align: center;
}
.sp-chip--mid {
  border-color: var(--green-deep); background: var(--green-soft);
}
.sp-badge {
  position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
  background: var(--green-deep); color: #fff;
  font-family: var(--font-display); font-weight: 700; font-size: 10px;
  padding: 2px 8px; border-radius: var(--radius-pill);
  white-space: nowrap;
}
.sp-name {
  font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); color: var(--ink);
}
.sp-mm {
  font-size: 11px; font-weight: 600; color: var(--ink-40); letter-spacing: .02em;
}
.sp-chip--mid .sp-mm { color: var(--green-deep); opacity: .7; }
.sp-val {
  font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); color: var(--green-deep);
  line-height: 1;
}
.sp-unit { font-size: var(--fs-xs); font-weight: 600; color: var(--ink-60); }

/* ── Pricing table ── */
.pricing-table {
  border-radius: var(--radius-lg); overflow: hidden;
  border: 1.5px solid var(--line); background: #fff;
}
.pt-head, .pt-row {
  display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr;
  gap: 0;
}
.pt-head {
  background: var(--green-deep); color: #fff;
  font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm);
}
.pt-head > *, .pt-row > * {
  padding: 12px 16px; border-right: 1px solid rgba(0,0,0,.07);
}
.pt-head > *:last-child, .pt-row > *:last-child { border-right: none; }
.pt-row { border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink); }
.pt-row:nth-child(even) { background: var(--offwhite); }
.pt-row--best { background: #fefce8 !important; font-weight: 600; }
.disc-tag {
  display: inline-block; font-size: 10px; font-weight: 700;
  background: #dcfce7; color: #15803d;
  padding: 1px 6px; border-radius: var(--radius-pill); margin-left: 4px;
}
.disc-tag--best { background: #fef08a; color: #854d0e; }

/* ── FAQ ── */
.faq-item { border-bottom: 1px solid var(--line); }
.faq-item:first-child { border-top: 1px solid var(--line); }
.acc-trigger {
  width: 100%; background: none; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 16px 0; text-align: left;
  font-family: var(--font-display); font-weight: 700; font-size: var(--fs-base); color: var(--ink);
}
.acc-icon { flex-shrink: 0; color: var(--ink-60); transition: transform .2s; }
.acc-trigger[aria-expanded="true"] .acc-icon { transform: rotate(180deg); }

@media (max-width: 600px) {
  .pricing-table { font-size: var(--fs-xs); }
  .pt-head > *, .pt-row > * { padding: 10px 8px; }
  .sp-val { font-size: var(--fs-base); }
}
</style>

<script>
// Thumbnail gallery switcher
document.addEventListener('DOMContentLoaded', () => {
  const mainPhoto = document.getElementById('main-photo') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.pdp-thumb');
  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const photo = thumb.dataset.photo;
      if (mainPhoto && photo) {
        mainPhoto.src = photo;
        mainPhoto.alt = thumb.getAttribute('aria-label') || '';
      }
      thumbs.forEach(t => t.classList.remove('is-active'));
      thumb.classList.add('is-active');
    });
  });
});
</script>
