---
// Review page for the 3D preview while it is built (3D-FIX-02..08).
// Not linked, not indexed, not in the sitemap. Removed when /builder swaps over.
import '@fontsource/nunito/600.css';
import '@fontsource/baloo-2/700.css';
import '@fontsource/russo-one/400.css';
import '../styles/tokens.css';
import { THEMES, COLOURS } from '../builder/themes';
// Preloaded so the header doesn't re-wrap (and push the stage down) when the fonts swap in
import balooBold from '@fontsource/baloo-2/files/baloo-2-latin-700-normal.woff2?url';
import nunitoSemi from '@fontsource/nunito/files/nunito-latin-600-normal.woff2?url';
import russoOne from '@fontsource/russo-one/files/russo-one-latin-400-normal.woff2?url';

// One colour leads and is the default; the rest keep their themes.ts order
const themes = Object.entries(THEMES)
  .map(([id, t]) => ({ id, label: t.label, swatch: t.swatch }))
  .sort((a, b) => Number(b.id === 'one') - Number(a.id === 'one'));
const DEFAULT_ONE = COLOURS.blue.hex;
const colours = Object.entries(COLOURS).map(([id, c]) => ({ id, ...c }));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>3D Builder Preview — TógBlocks</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href={balooBold} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={nunitoSemi} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={russoOne} as="font" type="font/woff2" crossorigin />
</head>
<body>
  <main class="p3">
    <header class="p3-head">
      <h1>3D preview <span class="p3-tag">review build</span></h1>
      <p>Real letters from the print files, laid out as they'd stand on a shelf. Drag to rotate.</p>
    </header>

    <div class="p3-stage">
      <!-- First paint: the name in the letters' own typeface (Russo One), until the 3D is ready -->
      <div class="p3-skel" id="p3-skel" aria-hidden="true">EMMA</div>
      <script is:inline>
        (function () {
          var m = /(?:^#|&)name=([A-Za-z0-9]{0,12})/.exec(location.hash);
          if (m && m[1]) document.getElementById('p3-skel').textContent = m[1].toUpperCase();
        })();
      </script>
      <canvas id="p3-canvas" aria-label="3D preview of your letters"></canvas>
      <div class="p3-views" role="group" aria-label="View">
        <button type="button" data-view="hero" aria-pressed="false">Hero</button>
        <button type="button" data-view="top" aria-pressed="true">Top</button>
        <button type="button" data-view="side" aria-pressed="false">Side</button>
      </div>
      <div class="p3-pop" id="p3-pop" role="dialog" aria-labelledby="p3-pop-title" hidden>
        <div class="p3-pop-head">
          <span id="p3-pop-title">Letter colour</span>
          <button type="button" class="p3-pop-close" id="p3-pop-close" aria-label="Close">×</button>
        </div>
        <div class="p3-pop-grid">
          {colours.map((c) => (
            <button type="button" class="p3-dot" data-pick={c.hex} title={c.label} aria-label={c.label}
                    aria-pressed="false" style={`background:${c.hex}`}></button>
          ))}
        </div>
      </div>
    </div>
    <p class="p3-hint">Tap a letter to change just its colour. Pinch to zoom.</p>

    <div class="p3-controls">
      <label class="p3-field">
        <span>Name</span>
        <input id="p3-name" type="text" value="EMMA" maxlength="12" autocomplete="off" spellcheck="false" />
      </label>
      <div class="p3-field">
        <span>Try</span>
        <div class="p3-row">
          {['EMMA', 'THOMAS', 'CHARLIE', 'ALEXANDER', 'Q8'].map((n) => <button type="button" data-sample={n}>{n}</button>)}
        </div>
      </div>
      <div class="p3-field">
        <span>Order</span>
        <div class="p3-row">
          <button type="button" id="p3-add" class="p3-add">Add to basket</button>
          <span class="p3-copied" id="p3-added" aria-live="polite"></span>
        </div>
      </div>
      <div class="p3-field">
        <span>Share</span>
        <div class="p3-row">
          <button type="button" id="p3-copy">Copy link to this design</button>
          <span class="p3-copied" id="p3-copied" aria-live="polite"></span>
        </div>
      </div>
      <div class="p3-field">
        <span>Theme</span>
        <div class="p3-row" id="p3-themes">
          {themes.map((t) => (
            <button type="button" data-theme={t.id} aria-pressed={t.id === 'one' ? 'true' : 'false'}>
              <i class="p3-sw">{t.swatch.slice(0, 4).map((c) => <b style={`background:${c}`}></b>)}</i>
              {t.label}
            </button>
          ))}
        </div>
      </div>
      <div class="p3-field">
        <span>One-colour pick</span>
        <div class="p3-row" id="p3-colours">
          {colours.map((c) => (
            <button type="button" class="p3-dot" data-hex={c.hex} title={c.label} aria-label={c.label}
                    aria-pressed={c.hex === DEFAULT_ONE ? 'true' : 'false'}
                    style={`background:${c.hex}`}></button>
          ))}
        </div>
      </div>
    </div>
  </main>

  <style>
    body { margin: 0; background: var(--offwhite); color: var(--ink); font-family: var(--font-body); }
    .p3 { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; display: flex; flex-direction: column; gap: 20px; }
    .p3-head h1 { font-family: var(--font-display); margin: 0; font-size: 1.8rem; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .p3-head p { margin: 4px 0 0; color: var(--ink-60); }
    .p3-tag { font: 600 .75rem var(--font-body); letter-spacing: .06em; text-transform: uppercase; background: var(--orange-soft); padding: 3px 8px; border-radius: 999px; }
    .p3-stage {
      position: relative; aspect-ratio: 4 / 3; border-radius: 20px; overflow: hidden;
      background: linear-gradient(180deg, #b6c0cc 0%, #a3aebb 55%, #929eac 100%);
      box-shadow: 0 4px 14px rgba(26,40,71,.08), 0 10px 24px rgba(26,40,71,.06);
    }
    .p3-skel {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      font-family: "Russo One", var(--font-display); font-size: 12vw; line-height: 1; letter-spacing: .02em;
      color: rgba(255,255,255,.6); white-space: nowrap; pointer-events: none;
      transition: opacity .3s ease-out; animation: p3-pulse 1.4s ease-in-out infinite alternate;
    }
    .p3-skel.is-gone { opacity: 0; animation: none; }
    @keyframes p3-pulse { from { opacity: .45; } to { opacity: .8; } }
    @media (prefers-reduced-motion: reduce) { .p3-skel { animation: none; opacity: .6; transition: none; } }
    #p3-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
    #p3-canvas:active { cursor: grabbing; }
    .p3-views { position: absolute; top: 12px; right: 12px; display: flex; gap: 4px; padding: 4px; background: rgba(255,255,255,.85); border-radius: 10px; }
    .p3-controls { display: flex; flex-direction: column; gap: 16px; }
    .p3-field { display: flex; flex-direction: column; gap: 8px; }
    .p3-field > span { font-weight: 600; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .05em; color: var(--ink-60); }
    .p3-field input { font: 700 1.4rem var(--font-display); text-transform: uppercase; padding: 8px 14px; border: 2px solid var(--line-strong); border-radius: 12px; max-width: 320px; }
    .p3-row { display: flex; flex-wrap: wrap; gap: 8px; }
    button { font: 600 .9rem var(--font-body); border: 2px solid var(--line-strong); background: var(--white); color: var(--ink); border-radius: 999px; padding: 6px 12px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
    button[aria-pressed="true"] { border-color: var(--green); background: var(--green-soft); }
    button:focus-visible, input:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }
    .p3-views button { border: 0; border-radius: 7px; }
    .p3-sw { display: inline-flex; gap: 2px; }
    .p3-sw b { width: 6px; height: 14px; border-radius: 2px; }
    .p3-dot { width: 30px; height: 30px; padding: 0; border-radius: 50%; }
    .p3-dot[aria-pressed="true"] { border-color: var(--ink); box-shadow: 0 0 0 2px var(--white) inset; }
    .p3-hint { margin: -10px 0 0; font-size: var(--fs-xs); color: var(--ink-60); }
    .p3-add { background: var(--green); border-color: var(--green); color: var(--white); }
    .p3-add:disabled { opacity: .6; cursor: progress; }
    .p3-copied a { color: var(--green); font-weight: 600; }
    .p3-copied { font-size: var(--fs-xs); color: var(--ink-60); align-self: center; }
    .p3-pop {
      position: absolute; z-index: 5; width: 212px; padding: 10px; display: flex; flex-direction: column; gap: 8px;
      background: var(--white); border-radius: 14px; box-shadow: 0 10px 32px rgba(26,40,71,.18), 0 2px 6px rgba(26,40,71,.08);
    }
    .p3-pop[hidden] { display: none; }
    .p3-pop-head { display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .05em; color: var(--ink-60); }
    .p3-pop-close { border: 0; padding: 0 6px; font-size: 1.2rem; line-height: 1; background: none; }
    .p3-pop-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; justify-items: center; }
  </style>

  <script>
    import type { BuilderPreview, ViewMode } from '../builder/BuilderPreview';
    import { encodeState, decodeState, previewChars, type PreviewState } from '../builder/previewState';
    import { COLOURS, THEMES, priceLetters, SIZE_LABELS, SIZE_MM, SIZE_CELL_PX } from '../builder/themes';
    import { countFilledCells } from '../builder/brickfont';
    import { addToCart } from '../builder/cart';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const canvas = $<HTMLCanvasElement>('p3-canvas');
    const input = $<HTMLInputElement>('p3-name');
    const pop = $('p3-pop');
    const popTitle = $('p3-pop-title');

    const DEFAULTS: PreviewState = { name: 'EMMA', theme: 'one', oneColour: COLOURS.blue.hex, letterColours: {} };
    let state = decodeState(location.hash, DEFAULTS);
    let popIndex = -1;

    const pressGroup = (sel: string, active: Element | null) =>
      document.querySelectorAll(sel).forEach((b) => b.setAttribute('aria-pressed', String(b === active)));
    const sameHex = (a: string, b: string) => a.toLowerCase() === b.toLowerCase();
    // Light tick on colour changes; no-op where unsupported (iOS Safari, desktop)
    const buzz = () => navigator.vibrate?.(10);

    let viewMode: ViewMode = 'top';
    let preview: BuilderPreview | null = null;

    // three.js (~150 KB gzipped) loads only once the page is up and idle, so typing,
    // scrolling and first paint never wait on WebGL. Controls work meanwhile; the
    // preview picks up whatever state exists when it starts.
    let booting: Promise<void> | null = null;
    async function boot(): Promise<void> {
      const { BuilderPreview } = await import('../builder/BuilderPreview');
      preview = new BuilderPreview(canvas, {
        ...state,
        size: 'standard',
        viewMode,
        onLetterClick: (i, x, y) => (i < 0 ? closePop() : openPop(i, x, y)),
      }, { onReady: hideSkeleton });
    }
    const whenIdle = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 200);
    const start = () => { booting ??= boot(); };
    if (document.readyState === 'complete') whenIdle(start);
    else addEventListener('load', () => whenIdle(start), { once: true });

    // ── HTML skeleton (first paint) ──
    const skel = $('p3-skel');
    let skeletonLive = true;
    function fitSkeleton(): void {
      if (!skeletonLive) return;
      skel.textContent = state.name;
      const stage = skel.parentElement!.getBoundingClientRect();
      // Russo One capitals average ~0.7em wide; fill ~86% of the width, cap the height
      const size = Math.min((stage.width * 0.86) / (Math.max(1, state.name.length) * 0.7), stage.height * 0.34);
      skel.style.fontSize = `${size}px`;
    }
    function hideSkeleton(): void {
      skeletonLive = false;
      skel.classList.add('is-gone');
      setTimeout(() => (skel.hidden = true), 350);
    }
    new ResizeObserver(fitSkeleton).observe(skel.parentElement!);
    fitSkeleton();

    /** Apply a state change to the preview, the controls and the URL hash. */
    function update(next: Partial<PreviewState>): void {
      state = { ...state, ...next };
      preview?.setProps(next);
      syncControls();
      fitSkeleton();
      syncAdd();
      history.replaceState(null, '', encodeState(state));
    }

    function syncControls(): void {
      if (input.value !== state.name) input.value = state.name;
      pressGroup('[data-theme]', document.querySelector(`[data-theme="${state.theme}"]`));
      pressGroup('[data-hex]', state.theme === 'one'
        ? [...document.querySelectorAll<HTMLElement>('[data-hex]')].find((b) => sameHex(b.dataset.hex!, state.oneColour)) ?? null
        : null);
      if (popIndex >= 0) markPopColour();
    }

    // ── Per-letter colour popover ──
    function openPop(i: number, x: number, y: number): void {
      popIndex = i;
      popTitle.textContent = `Letter ${i + 1} · ${state.name[i]}`;
      markPopColour();
      pop.hidden = false;
      const stage = canvas.getBoundingClientRect();
      const w = pop.offsetWidth, h = pop.offsetHeight;
      const left = Math.min(Math.max(8, x - w / 2), stage.width - w - 8);
      const top = y + 16 + h < stage.height ? y + 16 : Math.max(8, y - h - 16);
      pop.style.left = `${left}px`;
      pop.style.top = `${top}px`;
      pop.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus({ preventScroll: true });
    }
    function closePop(): void {
      popIndex = -1;
      pop.hidden = true;
    }
    function markPopColour(): void {
      if (!preview) return;
      const hex = preview.letterHex(popIndex);
      pop.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) =>
        b.setAttribute('aria-pressed', String(sameHex(b.dataset.pick!, hex))));
    }
    pop.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) =>
      b.addEventListener('click', () => {
        if (popIndex < 0) return;
        buzz();
        update({ letterColours: { ...state.letterColours, [popIndex]: b.dataset.pick! } });
      }));
    $('p3-pop-close').addEventListener('click', closePop);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePop(); });
    document.addEventListener('pointerdown', (e) => {
      if (!pop.hidden && !pop.contains(e.target as Node) && e.target !== canvas) closePop();
    });

    // ── Controls ──
    const setName = (v: string) => {
      closePop();
      update({ name: previewChars(v).join(''), letterColours: {} });
    };
    input.addEventListener('input', () => setName(input.value));
    document.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
      b.addEventListener('click', () => setName(b.dataset.sample!)));
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
      b.addEventListener('click', () => {
        pressGroup('[data-view]', b);
        closePop();
        viewMode = b.dataset.view as ViewMode;
        preview?.setProps({ viewMode });
      }));
    document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((b) =>
      b.addEventListener('click', () => { buzz(); update({ theme: b.dataset.theme!, letterColours: {} }); }));
    document.querySelectorAll<HTMLButtonElement>('[data-hex]').forEach((b) =>
      b.addEventListener('click', () => { buzz(); update({ theme: 'one', oneColour: b.dataset.hex!, letterColours: {} }); }));

    // ── Add to basket (3D-FIX-08: with a PNG of the design for the order) ──
    const addBtn = $<HTMLButtonElement>('p3-add');
    const added = $('p3-added');
    const SIZE = 'standard' as const;
    const priceLabel = () => `Add to basket · €${priceLetters(state.name.length, SIZE).toFixed(2)}`;
    const syncAdd = () => {
      addBtn.textContent = state.name ? priceLabel() : 'Add to basket';
      addBtn.disabled = !state.name;
    };
    input.addEventListener('input', syncAdd);

    async function uploadThumbnail(): Promise<string | undefined> {
      try {
        booting ??= boot();
        await booting;
        const png = await preview!.capture();
        const res = await fetch('/api/thumbnails', { method: 'POST', headers: { 'Content-Type': 'image/png' }, body: png });
        if (res.ok) return (await res.json()).id;
      } catch (err) {
        console.warn('Design preview not saved; adding to basket without it.', err);
      }
      return undefined; // the order still goes through, just without the picture
    }

    addBtn.addEventListener('click', async () => {
      if (!state.name) return;
      addBtn.disabled = true;
      added.textContent = 'Saving your design…';
      const thumbnailId = await uploadThumbnail();
      const letters = [...state.name].map((char, i) => ({
        char, colour: preview?.letterHex(i) ?? state.letterColours[i] ?? state.oneColour,
      }));
      addToCart({
        id: 'build_' + Date.now().toString(36),
        type: 'custom-name',
        name: state.name,
        size: SIZE,
        sizeLabel: `${SIZE_LABELS[SIZE]} (${SIZE_MM[SIZE]}cm)`,
        theme: state.theme,
        oneColour: THEMES[state.theme]?.single ? state.oneColour : null,
        brickSizePx: SIZE_CELL_PX[SIZE],
        letters,
        brickCount: letters.reduce((n, l) => n + countFilledCells(l.char), 0),
        price: priceLetters(letters.length, SIZE),
        currency: 'EUR',
        qty: 1,
        createdAt: new Date().toISOString(),
        addons: { dots: false, giftBox: false },
        ...(thumbnailId ? { thumbnailId } : {}),
      });
      added.innerHTML = 'Added. <a href="/cart">View basket →</a>';
      addBtn.disabled = false;
    });

    const copied = $('p3-copied');
    $('p3-copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        copied.textContent = 'Link copied';
      } catch {
        copied.textContent = location.href;
      }
    });

    // A pasted link (or back/forward) rebuilds the exact design
    window.addEventListener('hashchange', () => {
      closePop();
      const next = decodeState(location.hash, DEFAULTS);
      state = next;
      preview?.setProps(next);
      syncControls();
      fitSkeleton();
    });
    syncControls();
    syncAdd();
  </script>
</body>
</html>
